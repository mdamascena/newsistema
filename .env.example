# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
BASEPATH=
NEXT_PUBLIC_APP_URL=http://localhost:3000${BASEPATH}

# -----------------------------------------------------------------------------
# Backend Valoreal.CreditPlatform
# -----------------------------------------------------------------------------
# APIs .NET do repositório Valoreal.CreditPlatform. Use HTTP em
# desenvolvimento: as portas HTTPS (7210 e 7286) usam certificado
# autoassinado, que o fetch do Node rejeita.
AUTH_API_URL=http://localhost:5132
LOANS_API_URL=http://localhost:5033

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
# Gere um valor próprio com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_BASEPATH=${BASEPATH}/api/auth
NEXTAUTH_URL=http://localhost:3000${BASEPATH}/api/auth

# Google OAuth 2.0 — opcional. O provider só é registrado se ambos
# estiverem preenchidos (ver src/libs/auth.js).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# API interna de mock (herdada do template)
# -----------------------------------------------------------------------------
# Aponta para as rotas em src/app/api, que ainda servem os dados de
# src/fake-db. Sai quando as telas passarem a consumir o backend real.
API_URL=http://localhost:3000${BASEPATH}/api
NEXT_PUBLIC_API_URL=${API_URL}

# -----------------------------------------------------------------------------
# Demo do template — remover junto com as páginas de exemplo
# -----------------------------------------------------------------------------
# Usado só por apps/logistics/fleet
MAPBOX_ACCESS_TOKEN=
# Usado nos links de documentação do menu e da busca
NEXT_PUBLIC_DOCS_URL=https://demos.pixinvent.com/vuexy-nextjs-admin-template/documentation
